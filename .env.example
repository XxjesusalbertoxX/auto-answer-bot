# Credenciales de la cuenta SIAAUTT (obligatorias)
EMAIL=tu_email@ejemplo.com
PASSWORD=tu_contraseña

# URL base del portal (opcional, este es el valor por defecto)
BASE_URL=https://uttorreon.mx

# Matricula del alumno (opcional: el bot la detecta automaticamente al iniciar sesion)
# MATRICULA=2XXXXXXXX

# ---------------------------------------------------------------------------
# Modo humano (opcional): simula tiempos de una persona real
# ---------------------------------------------------------------------------
MODO_HUMANO=true
# Multiplicador de velocidad:
#   0.3 = rapido (~1 min)  |  0.6 = moderado (~2-3 min)  |  1.0 = realista (~5-8 min)
VELOCIDAD=0.6

# ---------------------------------------------------------------------------
# Clasificacion de preguntas (opcional)
# ---------------------------------------------------------------------------
# Preguntas de uso/filtro (¿usas...?, ¿recibiste...?) con opciones Si/No:
#   si = contesta "Si" (y aparecen las sub-preguntas)  |  no = contesta "No"
FILTRO_SINO=si

# Casillas de seleccion multiple:  una | todas
CHECKBOX=una

# Selects sin valoracion (¿que centro de computo...?):  primera | aleatoria
CATEGORICA=primera

# Texto que se escribe en los comentarios abiertos
TEXTO_ABIERTO=ninguno

# Palabras que hacen que una pregunta se responda con la SEGUNDA mejor opcion
# (ej. internet): separadas por comas
INTERNET_KW=internet,wifi,wi-fi
